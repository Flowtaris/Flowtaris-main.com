# -----------------------------------------------------
# Flowtaris Unified Admin Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# -----------------------------------------------------

# -- flowtaris.com Supabase --------------------------
# Your existing .com Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=your-com-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-com-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-com-service-role-key

# -- flowtaris.co Supabase ---------------------------
SUPABASE_URL_CO=your-co-supabase-url
SUPABASE_SERVICE_KEY_CO=your-co-service-role-key

# -- flowtaris.ai Supabase ---------------------------
SUPABASE_URL_AI=your-ai-supabase-url
SUPABASE_SERVICE_KEY_AI=your-ai-service-role-key

# (Optional) Also used by admin-content proxy for .com
SUPABASE_URL_COM=your-com-supabase-url
SUPABASE_SERVICE_KEY_COM=your-com-service-role-key
